{
  "cleanUrls": false,
  "functions": {
    "api/render-product.js": {
      "includeFiles": "{product.shell.html,nl/product.shell.html,fr/product.shell.html}"
    },
    "api/render-post.js": {
      "includeFiles": "{blog-post.shell.html,nl/blog-post.shell.html,fr/blog-post.shell.html}"
    }
  },
  "rewrites": [
    { "source": "/product.html", "destination": "/api/render-product?lang=en" },
    { "source": "/nl/product.html", "destination": "/api/render-product?lang=nl" },
    { "source": "/fr/product.html", "destination": "/api/render-product?lang=fr" },
    { "source": "/blog-post.html", "destination": "/api/render-post?lang=en" },
    { "source": "/nl/blog-post.html", "destination": "/api/render-post?lang=nl" },
    { "source": "/fr/blog-post.html", "destination": "/api/render-post?lang=fr" }
  ]
}
